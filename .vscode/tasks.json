{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Start Backend (FastAPI)",
      "type": "shell",
      "command": ".\\backend\\venv\\Scripts\\python.exe -m uvicorn main:app --app-dir .\\backend --reload --host 127.0.0.1 --port 8000",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "2. Start Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend-app"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start DataGraph AI (Full Stack)",
      "dependsOn": [
        "1. Start Backend (FastAPI)",
        "2. Start Frontend (Vite)"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
